# PostgreSQL (pgvector >= 0.7, ideally 0.8 for iterative scans)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ragdb

# OpenAI
OPENAI_API_KEY=sk-...

# Models
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
CHAT_MODEL=gpt-4o-mini

# RAG tuning
HNSW_EF_SEARCH=80
TOP_K=5
MIN_SIMILARITY=0.3
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# JWT — protects the EXTERNAL API routes (/api/query, /api/documents, /api/stats)
JWT_ALG=HS256
JWT_SECRET=change-me-32+chars-random
JWT_ISSUER=rag-api
JWT_AUDIENCE=rag-api

# ADMIN SECRET — gates the /admin panel (header x-admin-key).
# Rotate by changing this value and restarting the app.
ADMIN_SECRET=super-secret-admin-key-change-me