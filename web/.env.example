# Backend RAG API (Express service)
RAG_API_URL=http://localhost:3000

# MUST match the backend JWT config — used server-side only to mint
# rag:read / rag:write service tokens. Never exposed to the browser.
JWT_SECRET=change-me-32+chars-random
JWT_ISSUER=rag-api
JWT_AUDIENCE=rag-api

# ADMIN SECRET — gate for the /admin panel ingest.
# Change it here and restart: all previously distributed keys stop working.
ADMIN_SECRET=super-secret-admin-key-change-me
